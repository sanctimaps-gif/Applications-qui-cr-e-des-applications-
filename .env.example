# ---------------------------------------------------------------------------
# Forge — configuration
# Copiez ce fichier en `.env` et remplissez au moins UN fournisseur.
# Forge est agnostique : il fonctionne avec n'importe lequel, y compris 100 %
# en local via Ollama / LM Studio (aucun appel reseau sortant).
# ---------------------------------------------------------------------------

# --- Fournisseurs de modeles (au moins un) ---------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=

# 100 % local (aucune cle requise) : demarrez `ollama serve` puis decommentez.
# Le suffixe /v1 est ajoute automatiquement s'il manque.
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_HOST=http://127.0.0.1:1234

# --- GitHub ----------------------------------------------------------------
# Jeton personnel (classic: scope `repo` + `workflow`, ou fine-grained avec
# Contents: RW, Pull requests: RW, Workflows: RW, Administration: RW).
GITHUB_TOKEN=
# Optionnel : pousser dans une organisation plutot que sur votre compte
# GITHUB_OWNER=
# Optionnel : GitHub Enterprise
# GITHUB_API_URL=https://api.github.com

# --- Comportement ----------------------------------------------------------
# Ordre de preference des fournisseurs (le premier configure gagne)
# FORGE_PROVIDER_ORDER=ollama,openai,anthropic,google,mistral,groq,deepseek,openrouter

# Surcharge des modeles par palier (fast / balanced / deep)
# FORGE_OPENAI_MODEL_DEEP=gpt-5
# FORGE_OPENAI_MODEL_BALANCED=gpt-5
# FORGE_OPENAI_MODEL_FAST=gpt-5-mini
# FORGE_ANTHROPIC_MODEL_DEEP=claude-opus-5
# FORGE_OLLAMA_MODEL_BALANCED=qwen2.5-coder:32b

# Performance. 0 = illimite / auto.
FORGE_CONCURRENCY=0
FORGE_JOB_CONCURRENCY=0
FORGE_REQUEST_TIMEOUT_MS=600000
FORGE_CACHE=1

# Limites. 0 = AUCUNE LIMITE (valeur par defaut sur toute la ligne).
FORGE_MAX_FILES=0
FORGE_MAX_REPAIR_ATTEMPTS=0
FORGE_MAX_PROJECTS=0
FORGE_MAX_TOKENS=0

# Verification automatique (install/build/test) du code genere
FORGE_VERIFY=1

# Racine des projets generes
# FORGE_WORKSPACE=/chemin/vers/forge-projects

# Serveur
FORGE_PORT=7331
FORGE_HOST=127.0.0.1
# Jeton facultatif pour proteger l'API/UI si vous l'exposez
# FORGE_AUTH_TOKEN=
